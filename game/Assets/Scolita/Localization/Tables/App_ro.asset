  m_SharedData: {fileID: 11400000, guid: ee8b3c5d63fa2864f873169ff6cfe091, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1473302528
    m_Localized: Hai!
    m_Metadata:
      m_Items: []
  - m_Id: 1645268992
    m_Localized: "Pentru p\u0103rin\u021Bi"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463296
    m_Localized: Versiunea {0}
    m_Metadata:
      m_Items: []
  - m_Id: 1649463297
    m_Localized: "Ce a \xEEnv\u0103\u021Bat"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463298
    m_Localized: "\xEEnv\u0103\u021Bat\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463299
    m_Localized: "\xEEn lucru"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463300
    m_Localized: "nou\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463301
    m_Localized: "Rom\xE2n\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463302
    m_Localized: "Englez\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463303
    m_Localized: "Zile \xEEn care a jucat (ultimele 2 s\u0103pt\u0103m\xE2ni)"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463304
    m_Localized: "Urmeaz\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463305
    m_Localized: 'Planeta {0}: litera {1}, {2}'
    m_Metadata:
      m_Items: []
  - m_Id: 1649463306
    m_Localized: 'Planeta {0}: exersare, {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 1649463307
    m_Localized: "\xEEn rom\xE2n\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463308
    m_Localized: "\xEEn englez\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463309
    m_Localized: "\xEEn ambele limbi"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463310
    m_Localized: "Toate lec\u021Biile sunt f\u0103cute."
    m_Metadata:
      m_Items: []
  - m_Id: 1649463311
    m_Localized: "Vocile \xEEnregistrate"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463312
    m_Localized: "Rom\xE2n\u0103: {0} din {1} \xB7 Englez\u0103: {2} din {3}. Restul
      \xEEl spune vocea tabletei."
    m_Metadata:
      m_Items: []
  - m_Id: 1649463313
    m_Localized: "Set\u0103ri"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463314
    m_Localized: "Limbile lec\u021Biilor"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463315
    m_Localized: "Am\xE2ndou\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463316
    m_Localized: "Doar rom\xE2n\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463317
    m_Localized: "Doar englez\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463318
    m_Localized: "Limit\u0103 de timp pe zi"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463319
    m_Localized: "F\u0103r\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463320
    m_Localized: '{0} min'
    m_Metadata:
      m_Items: []
  - m_Id: 1649463321
    m_Localized: "Lec\u021Bia \xEEnceput\u0103 se termin\u0103 mereu; apoi racheta
      se odihne\u0219te p\xE2n\u0103 m\xE2ine."
    m_Metadata:
      m_Items: []
  - m_Id: 1649463322
    m_Localized: Vocea
    m_Metadata:
      m_Items: []
  - m_Id: 1649463323
    m_Localized: "Meniurile \xEEn englez\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463324
    m_Localized: "\u0218terge progresul\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463325
    m_Localized: "\u0218tergi progresul?"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463326
    m_Localized: "Se pierd literele \xEEnv\u0103\u021Bate, lec\u021Biile f\u0103cute,
      locul de pe hart\u0103, stelele, ab\u021Bibildurile \u0219i d\xE2rele. Set\u0103rile
      r\u0103m\xE2n."
    m_Metadata:
      m_Items: []
  - m_Id: 1649463327
    m_Localized: Sigur?
    m_Metadata:
      m_Items: []
  - m_Id: 1649463328
    m_Localized: "Progresul nu se mai poate aduce \xEEnapoi."
    m_Metadata:
      m_Items: []
  - m_Id: 1649463329
    m_Localized: "Nu, p\u0103streaz\u0103-l"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463330
    m_Localized: "Da, \u0219terge"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463331
    m_Localized: "\u0218terge tot"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463332
    m_Localized: "Progresul a fost \u0219ters."
    m_Metadata:
      m_Items: []
  - m_Id: 1649463333
    m_Localized: "Atinge num\u0103rul pe care \xEEl auzi."
    m_Metadata:
      m_Items: []
  - m_Id: 1649463334
    m_Localized: "Atinge num\u0103rul {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 1649463335
    m_Localized: "Ascult\u0103 din nou"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463336
    m_Localized: unsprezece
    m_Metadata:
      m_Items: []
  - m_Id: 1649463337
    m_Localized: doisprezece
    m_Metadata:
      m_Items: []
  - m_Id: 1649463338
    m_Localized: treisprezece
    m_Metadata:
      m_Items: []
  - m_Id: 1649463339
    m_Localized: paisprezece
    m_Metadata:
      m_Items: []
  - m_Id: 1649463340
    m_Localized: cincisprezece
    m_Metadata:
      m_Items: []
  - m_Id: 1649463341
    m_Localized: "\u0219aisprezece"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463342
    m_Localized: "\u0219aptesprezece"
    m_Metadata:
      m_Items: []
  - m_Id: 1649463343
    m_Localized: optsprezece
    m_Metadata:
      m_Items: []
  - m_Id: 1649463344
    m_Localized: "nou\u0103sprezece"
    m_Metadata:
      m_Items: []
  - m_Id: 3593630437376
    m_Localized: Cerul meu
    m_Metadata:
      m_Items: []
  - m_Id: 3593752072192
    m_Localized: "Ab\u021Bibilduri"
    m_Metadata:
      m_Items: []
  - m_Id: 3593752072193
    m_Localized: "D\xE2re"
    m_Metadata:
      m_Items: []
  - m_Id: 3593752072194
    m_Localized: Bravo!
    m_Metadata:
      m_Items: []
  - m_Id: 3593752072195
    m_Localized: Mai departe
    m_Metadata:
      m_Items: []
  - m_Id: 3593752072196
    m_Localized: "\xCEn cartea mea"
    m_Metadata:
      m_Items: []
  - m_Id: 8785503506432
    m_Localized: "Progresul nu a putut fi \u0219ters de tot. \xCEncearc\u0103 din
      nou."
    m_Metadata:
      m_Items: []
  - m_Id: 38665817477120
    m_Localized: Profil de test
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860672
    m_Localized: "F\u0103r\u0103 nume"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860673
    m_Localized: Copil
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860674
    m_Localized: "Nu se arat\u0103 copiilor"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860675
    m_Localized: "Litere \xEEnv\u0103\u021Bate: rom\xE2n\u0103 {0}, englez\u0103
      {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860676
    m_Localized: "N-a jucat \xEEnc\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860677
    m_Localized: A jucat azi
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860678
    m_Localized: A jucat ieri
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860679
    m_Localized: "A jucat ultima dat\u0103 pe {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860680
    m_Localized: Profiluri
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860681
    m_Localized: "Numele \u0219i pozele r\u0103m\xE2n doar pe tablet\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860682
    m_Localized: Cine are profil
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860683
    m_Localized: "Adaug\u0103 un copil"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860684
    m_Localized: "Joac\u0103 ca tester"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860685
    m_Localized: "\u0218terge progresul de test"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860686
    m_Localized: "F\u0103 un profil de test"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860688
    m_Localized: "Schimb\u0103 profilul"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860689
    m_Localized: Un copil nou
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860690
    m_Localized: Numele (cel mult {0} de caractere)
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860691
    m_Localized: Scrie numele aici
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860692
    m_Localized: Numele are cel mult {0} de caractere.
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860693
    m_Localized: "Numele are doar litere, cu un spa\u021Biu sau o cratim\u0103 \xEEntre
      p\u0103r\u021Bi."
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860694
    m_Localized: Poza (o alege copilul)
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860695
    m_Localized: "\u0218terge profilul\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860696
    m_Localized: "Salveaz\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860697
    m_Localized: "Adaug\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860698
    m_Localized: Profilul a fost salvat.
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860699
    m_Localized: "Profilul nu a putut fi salvat. \xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860700
    m_Localized: "Profilul a fost \u0219ters."
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860701
    m_Localized: "Profilul a fost scos din list\u0103, dar unele fi\u0219iere au
      r\u0103mas pe tablet\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860702
    m_Localized: "Progresul de test a fost \u0219ters."
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860703
    m_Localized: "Progresul de test nu a putut fi \u0219ters de tot. \xCEncearc\u0103
      din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860704
    m_Localized: "\u0218tergi profilul?"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860705
    m_Localized: "Se pierd literele \xEEnv\u0103\u021Bate, lec\u021Biile f\u0103cute,
      locul pe hart\u0103, stelele, ab\u021Bibildurile \u0219i d\xE2rele acestui
      profil. Celelalte profiluri r\u0103m\xE2n a\u0219a cum sunt."
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860706
    m_Localized: Sigur?
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860707
    m_Localized: "Profilul \u0219i tot ce are se \u0219terg de pe tablet\u0103 \u0219i
      nu mai pot fi aduse \xEEnapoi."
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860708
    m_Localized: "\u0218terge profilul"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860709
    m_Localized: "Schimb\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860710
    m_Localized: TEST
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860711
    m_Localized: Sari peste pas
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860712
    m_Localized: "{0} \xB7 toate lec\u021Biile se deschid"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860713
    m_Localized: "{0} \xB7 {1} \xB7 pasul {2} ({3}) \xB7 {4}"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860714
    m_Localized: "{0}: \xEEnregistrare"
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860715
    m_Localized: '{0}: vocea tabletei'
    m_Metadata:
      m_Items: []
  - m_Id: 38665976860716
    m_Localized: '{0}: doar balonul'
    m_Metadata:
      m_Items: []
  - m_Id: 75522890584064
    m_Localized: Muzica
    m_Metadata:
      m_Items: []
  - m_Id: 75523058356224
    m_Localized: Sunetele
    m_Metadata:
      m_Items: []
  - m_Id: 75523058356225
    m_Localized: "Vibra\u021Bii"
    m_Metadata:
      m_Items: []
  references:
